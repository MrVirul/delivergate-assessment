<Window x:Class="DesktopApp.Views.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Item"
        Height="660"
        Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundBrush}">
    <Border Margin="16"
            Padding="22"
            Background="White"
            CornerRadius="8">
        <StackPanel>
            <TextBlock Text="Item Details"
                       FontSize="19"
                       FontWeight="Bold"
                       Foreground="#263238"
                       Margin="0,0,0,16" />

            <TextBlock Text="Item name"
                       FontWeight="SemiBold"
                       Foreground="#37474F" />
            <TextBox x:Name="NameTextBox"
                     Style="{StaticResource InputTextBox}"
                     Margin="0,5,0,12" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Category"
                               FontWeight="SemiBold"
                               Foreground="#37474F" />
                    <ComboBox x:Name="CategoryComboBox"
                              Style="{StaticResource InputComboBox}"
                              Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Unit"
                               FontWeight="SemiBold"
                               Foreground="#37474F" />
                    <ComboBox x:Name="UnitComboBox"
                              Style="{StaticResource InputComboBox}"
                              Margin="0,5,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Description"
                       FontWeight="SemiBold"
                       Foreground="#37474F" />
            <TextBox x:Name="DescriptionTextBox"
                     Style="{StaticResource InputTextBox}"
                     Height="52"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,5,0,12" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Stock quantity"
                               FontWeight="SemiBold"
                               Foreground="#37474F" />
                    <TextBox x:Name="QuantityTextBox"
                             Style="{StaticResource InputTextBox}"
                             Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Reorder level"
                               FontWeight="SemiBold"
                               Foreground="#37474F" />
                    <TextBox x:Name="ReorderLevelTextBox"
                             Style="{StaticResource InputTextBox}"
                             Margin="0,5,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Price ($)"
                       FontWeight="SemiBold"
                       Foreground="#37474F" />
            <TextBox x:Name="PriceTextBox"
                     Style="{StaticResource InputTextBox}"
                     Margin="0,5,0,12" />

            <TextBlock x:Name="ErrorText"
                       Foreground="#B71C1C"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button Content="Cancel"
                        IsCancel="True"
                        Width="90"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" />
                <Button Content="Save"
                        IsDefault="True"
                        Click="Save_Click"
                        Width="90"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
