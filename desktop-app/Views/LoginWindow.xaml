<Window x:Class="DesktopApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Login"
        Height="470"
        Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}">
    <Grid>
        <Border Width="370"
                Padding="30"
                Background="White"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Opacity="0.15"
                                  Color="#37474F" />
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Welcome Back"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#263238" />
                <TextBlock Text="Sign in to Enterprise Management System"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,4,0,22" />

                <TextBlock Text="Email"
                           FontWeight="SemiBold"
                           Foreground="#37474F" />
                <TextBox x:Name="EmailTextBox"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBox}"
                         Margin="0,5,0,14" />

                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Foreground="#37474F" />
                <PasswordBox x:Name="PasswordBox"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Style="{StaticResource InputPasswordBox}"
                             Margin="0,5,0,18" />

                <Button Content="Login"
                        Command="{Binding LoginCommand}"
                        IsDefault="True"
                        Height="38"
                        Style="{StaticResource PrimaryButton}" />

                <TextBlock Text="Signing in..."
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Margin="0,10,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border Background="#FDECEA"
                        BorderBrush="#F5C6C2"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,14,0,0"
                        Visibility="{Binding IsErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#B71C1C"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
