<Window x:Class="DesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enterprise Management System"
        Height="640"
        Width="1080"
        MinHeight="480"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsLoggingOut, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True"
                                 Width="80"
                                 Height="4"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LogoutStatusMessage}"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="Log out"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Enterprise Management System"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#263238" />
                <TextBlock Text="{Binding UserSummary}"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Action error banner (e.g. 403 Forbidden or validation errors) -->
        <Border Grid.Row="1"
                Background="#FDECEA"
                BorderBrush="#F5C6C2"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,9"
                Margin="0,0,0,10"
                Visibility="{Binding IsActionErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ActionError}"
                       Foreground="#B71C1C"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <TabControl Grid.Row="2"
                    Background="White"
                    BorderBrush="#DDE3E8"
                    Padding="0">
            <!-- Inventory Tab -->
            <TabItem Header="Inventory Management">
                <Grid Margin="14" Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Add Item"
                                Command="{Binding AddItemCommand}"
                                IsEnabled="{Binding CanCreateItem}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Edit Selected"
                                Command="{Binding EditItemCommand}"
                                IsEnabled="{Binding CanEditItem}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Delete Selected"
                                Command="{Binding DeleteItemCommand}"
                                IsEnabled="{Binding CanDeleteItem}"
                                Style="{StaticResource DangerButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Inventory}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#ECEFF1"
                              BorderBrush="#DDE3E8"
                              RowHeaderWidth="0"
                              RowBackground="White"
                              AlternatingRowBackground="#FAFBFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item ID"
                                                Binding="{Binding Id}"
                                                Width="75" />
                            <DataGridTextColumn Header="Item Name"
                                                Binding="{Binding Name}"
                                                Width="*" />
                            <DataGridTextColumn Header="Category"
                                                Binding="{Binding Category}"
                                                Width="100" />
                            <DataGridTextColumn Header="Stock Quantity"
                                                Binding="{Binding Quantity}"
                                                Width="115" />
                            <DataGridTextColumn Header="Unit"
                                                Binding="{Binding Unit}"
                                                Width="70" />
                            <DataGridTextColumn Header="Price ($)"
                                                Binding="{Binding Price, StringFormat={}{0:0.00}}"
                                                Width="90" />
                            <DataGridTextColumn Header="Reorder Level"
                                                Binding="{Binding ReorderLevel}"
                                                Width="105" />
                            <DataGridTextColumn Header="Low Stock"
                                                Binding="{Binding StockStatus}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LowStock}" Value="True">
                                                <Setter Property="Foreground" Value="#C62828" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               Text="* Cashiers can update existing items; Managers can add and update items; only Owners can delete items."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Margin="0,10,0,0" />
                </Grid>
            </TabItem>

            <!-- Customer Tab -->
            <TabItem Header="Customer Management">
                <Grid Margin="14" Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Add Customer"
                                Command="{Binding AddCustomerCommand}"
                                IsEnabled="{Binding CanModifyCustomers}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Edit Customer"
                                Command="{Binding EditCustomerCommand}"
                                IsEnabled="{Binding CanModifyCustomers}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Delete Customer"
                                Command="{Binding DeleteCustomerCommand}"
                                IsEnabled="{Binding CanDeleteCustomer}"
                                Style="{StaticResource DangerButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#ECEFF1"
                              BorderBrush="#DDE3E8"
                              RowHeaderWidth="0"
                              RowBackground="White"
                              AlternatingRowBackground="#FAFBFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Customer ID"
                                                Binding="{Binding Id}"
                                                Width="95" />
                            <DataGridTextColumn Header="Full Name"
                                                Binding="{Binding Name}"
                                                Width="*" />
                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                Width="220" />
                            <DataGridTextColumn Header="Phone Number"
                                                Binding="{Binding Phone}"
                                                Width="140" />
                            <DataGridTextColumn Header="Address"
                                                Binding="{Binding Address}"
                                                Width="220" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               Text="* All roles can add and edit customer records; only Owners can delete customer records."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Margin="0,10,0,0" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
