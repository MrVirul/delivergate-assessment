# Copy this file to .env, then fill in DATABASE_URL and JWT_SECRET.
# Never commit the real .env file.
APP_ENV=development
APP_PORT=8080
# Required: PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
# Required: random secret of at least 32 characters
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_TTL_MINUTES=60
AUTO_MIGRATE=true
BCRYPT_COST=12
CORS_ALLOW_ORIGINS=http://localhost:3000
LOGIN_RATE_LIMIT_PER_MIN=10

# Seed account credentials (dev defaults; override in any shared environment)
SEED_OWNER_EMAIL=owner@mail.com
SEED_OWNER_PASSWORD=Owner@123
SEED_MANAGER_EMAIL=manager@mail.com
SEED_MANAGER_PASSWORD=Manager@123
SEED_CASHIER_EMAIL=cashier@mail.com
SEED_CASHIER_PASSWORD=Cashier@123
