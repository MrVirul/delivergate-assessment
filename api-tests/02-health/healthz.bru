meta {
  name: Health Check
  type: http
  seq: 1
  tags: [
    health
    smoke
  ]
}

get {
  url: {{baseUrl}}/healthz
  body: none
  auth: none
}

tests {
  test("health endpoint is ok", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("ok");
  });
}

example {
  name: Health check - 200 OK
  description: Container liveness probe reports the service is healthy.
  
  request: {
    url: http://localhost:8080/healthz
    method: GET
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "status": "ok"
        }
      '''
    }
  }
}
