meta {
  name: Replace Customer
  type: http
  seq: 4
  tags: [
    customers
    write
  ]
}

put {
  url: {{baseUrl}}/api/customers/{{customerId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Ishara Weerasinghe",
    "email": "ishara.weerasinghe@gmail.com",
    "phone": "+94 76 543 2109",
    "address": "No. 42, Havelock Road, Colombo 05",
    "notes": "Moved to Havelock Town, prefers delivery on Saturday mornings"
  }
}

tests {
  test("replaces the customer", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.phone).to.equal("+94 76 543 2109");
    expect(res.body.data.address).to.equal("No. 42, Havelock Road, Colombo 05");
  });
}

example {
  name: Replace customer - 200 OK
  description: Customer moves to Havelock Town and updates phone and delivery address.
  
  request: {
    url: http://localhost:8080/api/customers/6
    method: PUT
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "name": "Ishara Weerasinghe",
        "email": "ishara.weerasinghe@gmail.com",
        "phone": "+94 76 543 2109",
        "address": "No. 42, Havelock Road, Colombo 05",
        "notes": "Moved to Havelock Town, prefers delivery on Saturday mornings"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": 6,
            "name": "Ishara Weerasinghe",
            "email": "ishara.weerasinghe@gmail.com",
            "phone": "+94 76 543 2109",
            "address": "No. 42, Havelock Road, Colombo 05",
            "notes": "Moved to Havelock Town, prefers delivery on Saturday mornings",
            "created_by_id": 1,
            "updated_by_id": 1,
            "created_at": "2026-10-30T10:44:12+05:30",
            "updated_at": "2026-10-30T10:45:01+05:30"
          }
        }
      '''
    }
  }
}
