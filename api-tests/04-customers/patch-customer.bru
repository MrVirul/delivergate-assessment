meta {
  name: Patch Customer
  type: http
  seq: 5
  tags: [
    customers
    write
  ]
}

patch {
  url: {{baseUrl}}/api/customers/{{customerId}}
  body: json
  auth: inherit
}

body:json {
  {
    "address": "No. 42/1, Havelock Road, Colombo 05",
    "notes": "Apartment number updated after the move, call before delivery"
  }
}

tests {
  test("patches only the supplied fields", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.address).to.equal("No. 42/1, Havelock Road, Colombo 05");
    expect(res.body.data.phone).to.equal("+94 76 543 2109");
  });
}

example {
  name: Patch customer - 200 OK
  description: Apartment number and delivery notes are corrected after the move.
  
  request: {
    url: http://localhost:8080/api/customers/6
    method: PATCH
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "address": "No. 42/1, Havelock Road, Colombo 05",
        "notes": "Apartment number updated after the move, call before delivery"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": 6,
            "name": "Ishara Weerasinghe",
            "email": "ishara.weerasinghe@gmail.com",
            "phone": "+94 76 543 2109",
            "address": "No. 42/1, Havelock Road, Colombo 05",
            "notes": "Apartment number updated after the move, call before delivery",
            "created_by_id": 1,
            "updated_by_id": 1,
            "created_at": "2026-10-30T10:44:12+05:30",
            "updated_at": "2026-10-30T10:45:38+05:30"
          }
        }
      '''
    }
  }
}
