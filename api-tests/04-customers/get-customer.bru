meta {
  name: Get Customer
  type: http
  seq: 3
  tags: [
    customers
    read
  ]
}

get {
  url: {{baseUrl}}/api/customers/{{customerId}}
  body: none
  auth: inherit
}

tests {
  test("returns the requested customer", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.id).to.equal(Number(bru.getVar("customerId")));
    expect(res.body.data).to.have.property("email");
  });
}

example {
  name: Get customer - 200 OK
  description: Reads back Ishara Weerasinghe, created earlier in the run.
  
  request: {
    url: http://localhost:8080/api/customers/6
    method: GET
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": 6,
            "name": "Ishara Weerasinghe",
            "email": "ishara.weerasinghe@gmail.com",
            "phone": "+94 77 987 6543",
            "address": "No. 18, Flower Road, Colombo 07",
            "notes": "Weekend regular, collects two kithul treacle tubs for family gatherings",
            "created_by_id": 1,
            "updated_by_id": 1,
            "created_at": "2026-10-30T10:44:12+05:30",
            "updated_at": "2026-10-30T10:44:12+05:30"
          }
        }
      '''
    }
  }
}
