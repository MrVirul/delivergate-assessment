meta {
  name: Replace Item
  type: http
  seq: 4
  tags: [
    items
    write
  ]
}

put {
  url: {{baseUrl}}/api/items/{{itemId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Ceylon Vanilla Reserve",
    "category": "flavor",
    "description": "Small-batch Ceylon vanilla bean ice cream, now packed in five litre tubs",
    "quantity": 24,
    "unit": "tub",
    "price_cents": 195000,
    "reorder_level": 8
  }
}

tests {
  test("replaces the item", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.quantity).to.equal(24);
    expect(res.body.data.price_cents).to.equal(195000);
    expect(res.body.data.reorder_level).to.equal(8);
  });
}

example {
  name: Replace item - 200 OK
  description: Owner restocks and reprices the reserve flavour after the weekend batch.
  
  request: {
    url: http://localhost:8080/api/items/11
    method: PUT
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "name": "Ceylon Vanilla Reserve",
        "category": "flavor",
        "description": "Small-batch Ceylon vanilla bean ice cream, now packed in five litre tubs",
        "quantity": 24,
        "unit": "tub",
        "price_cents": 195000,
        "reorder_level": 8
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": 11,
            "name": "Ceylon Vanilla Reserve",
            "category": "flavor",
            "description": "Small-batch Ceylon vanilla bean ice cream, now packed in five litre tubs",
            "quantity": 24,
            "unit": "tub",
            "price_cents": 195000,
            "reorder_level": 8,
            "low_stock": false,
            "created_by_id": 1,
            "updated_by_id": 1,
            "created_at": "2026-10-30T10:42:18+05:30",
            "updated_at": "2026-10-30T10:43:05+05:30"
          }
        }
      '''
    }
  }
}
