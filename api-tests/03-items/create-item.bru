meta {
  name: Create Item
  type: http
  seq: 2
  tags: [
    items
    write
  ]
}

post {
  url: {{baseUrl}}/api/items
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Ceylon Vanilla Reserve",
    "category": "flavor",
    "description": "Small-batch Ceylon vanilla bean ice cream churned for the weekend rush",
    "quantity": 18,
    "unit": "tub",
    "price_cents": 185000,
    "reorder_level": 6
  }
}

script:post-response {
  bru.setVar("itemId", res.body.data.id);
}

tests {
  test("creates an item", function() {
    expect(res.status).to.equal(201);
    expect(res.body.data.id).to.be.a("number");
    expect(res.body.data.name).to.equal("Ceylon Vanilla Reserve");
    expect(res.body.data.category).to.equal("flavor");
    expect(res.body.data.quantity).to.equal(18);
    expect(res.body.data.price_cents).to.equal(185000);
  });
}

example {
  name: Create item - 201 Created
  description: Adds the new Ceylon Vanilla Reserve flavour to the shop inventory.
  
  request: {
    url: http://localhost:8080/api/items
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "name": "Ceylon Vanilla Reserve",
        "category": "flavor",
        "description": "Small-batch Ceylon vanilla bean ice cream churned for the weekend rush",
        "quantity": 18,
        "unit": "tub",
        "price_cents": 185000,
        "reorder_level": 6
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": 11,
            "name": "Ceylon Vanilla Reserve",
            "category": "flavor",
            "description": "Small-batch Ceylon vanilla bean ice cream churned for the weekend rush",
            "quantity": 18,
            "unit": "tub",
            "price_cents": 185000,
            "reorder_level": 6,
            "low_stock": false,
            "created_by_id": 1,
            "updated_by_id": 1,
            "created_at": "2026-10-30T10:42:18+05:30",
            "updated_at": "2026-10-30T10:42:18+05:30"
          }
        }
      '''
    }
  }
}
