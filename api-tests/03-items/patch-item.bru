meta {
  name: Patch Item
  type: http
  seq: 5
  tags: [
    items
    write
  ]
}

patch {
  url: {{baseUrl}}/api/items/{{itemId}}
  body: json
  auth: inherit
}

body:json {
  {
    "quantity": 7,
    "price_cents": 200000
  }
}

tests {
  test("patches only the supplied fields", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.quantity).to.equal(7);
    expect(res.body.data.price_cents).to.equal(200000);
    expect(res.body.data.reorder_level).to.equal(8);
  });
}

example {
  name: Patch item - 200 OK
  description: Quantity drops below the reorder level, so low_stock flips to true.
  
  request: {
    url: http://localhost:8080/api/items/11
    method: PATCH
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "quantity": 7,
        "price_cents": 200000
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": 11,
            "name": "Ceylon Vanilla Reserve",
            "category": "flavor",
            "description": "Small-batch Ceylon vanilla bean ice cream, now packed in five litre tubs",
            "quantity": 7,
            "unit": "tub",
            "price_cents": 200000,
            "reorder_level": 8,
            "low_stock": true,
            "created_by_id": 1,
            "updated_by_id": 1,
            "created_at": "2026-10-30T10:42:18+05:30",
            "updated_at": "2026-10-30T10:43:47+05:30"
          }
        }
      '''
    }
  }
}
