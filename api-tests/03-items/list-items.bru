meta {
  name: List Items
  type: http
  seq: 1
  tags: [
    items
    read
  ]
}

get {
  url: {{baseUrl}}/api/items
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 20
  sort: name
}

tests {
  test("returns a paginated list", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta).to.have.property("page");
    expect(res.body.meta).to.have.property("limit");
    expect(res.body.meta).to.have.property("total");
    expect(res.body.meta).to.have.property("total_pages");
  });
}

